#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


/usr/bin/tailwindcss -i hereditasarbor/static/css/project.css -o hereditasarbor/static/css/output.css --minify
python manage.py migrate
source scripts/load_initial_data.sh

exec gunicorn config.wsgi --bind 0.0.0.0:8000 --chdir=/app --workers=1 --threads=2 --reload