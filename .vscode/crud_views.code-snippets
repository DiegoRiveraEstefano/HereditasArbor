{
      "create new model views subset": {
            "scope": "python",
            "prefix": "mviews_crud",
            "body": [
                  "class ${1/(.*)/${1:/pascalcase}/}DetailView(DetailView):",
                  "    model = ${1/(.*)/${1:/pascalcase}/}",
                  "    template_name = \"${1/(.*)/${1:/downcase}/}/views/${1/(.*)/${1:/downcase}/}_detail.html\"",
                  "    slug_field = \"pk\"",
                  "    slug_url_kwarg = \"pk\"",
                  "",
                  "",
                  "${1/(.*)/${1:/downcase}/}_detail_view = $1DetailView.as_view()",
                  "",
                  "",
                  "class ${1/(.*)/${1:/pascalcase}/}ListView(ListView):",
                  "    model = ${1/(.*)/${1:/pascalcase}/}",
                  "    template_name = \"${1/(.*)/${1:/downcase}/}/views/${1/(.*)/${1:/downcase}/}_list.html\"",
                  "",
                  "    def get_queryset(self):",
                  "        return super().get_queryset()",
                  "",
                  "",
                  "${1/(.*)/${1:/downcase}/}_list_view = ${1/(.*)/${1:/pascalcase}/}ListView.as_view()",
                  "",
                  "",
                  "class ${1/(.*)/${1:/pascalcase}/}CreateView(CreateView):",
                  "    model = ${1/(.*)/${1:/pascalcase}/}",
                  "    template_name = \"${1/(.*)/${1:/downcase}/}/views/${1/(.*)/${1:/downcase}/}_create.html\"",
                  "    form_class = ${1/(.*)/${1:/pascalcase}/}CreateForm",
                  "",
                  "${1/(.*)/${1:/downcase}/}_create_view = $1CreateView.as_view()",
                  "",
                  "class ${1/(.*)/${1:/pascalcase}/}UpdateView(UpdateView):",
                  "    model = ${1/(.*)/${1:/pascalcase}/}",
                  "    template_name = \"${1/(.*)/${1:/downcase}/}/views/${1/(.*)/${1:/downcase}/}_update.html\"",
                  "    form_class = ${1/(.*)/${1:/pascalcase}/}UpdateForm",
                  "",
                  "${1/(.*)/${1:/downcase}/}_update_view = $1UpdateView.as_view()",
                  "",
                  "",
                  "class ${1/(.*)/${1:/pascalcase}/}DeleteView(DeleteView):",
                  "    model = ${1/(.*)/${1:/pascalcase}/}",
                  "    template_name = \"${1/(.*)/${1:/downcase}/}/views/${1/(.*)/${1:/downcase}/}_delete.html\"",
                  "",
                  "${1/(.*)/${1:/downcase}/}_delete_view = $1DeleteView.as_view()",
            ],
            "description": "Create a subset of views from a model"
      }
