# General
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Security
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True

# Email
# ------------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=no-reply@yourdomain.com

# django-allauth
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery / Flower
# ------------------------------------------------------------------------------
CELERY_FLOWER_USER=flower_admin
CELERY_FLOWER_PASSWORD=change-me-flower-password
